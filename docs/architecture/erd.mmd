erDiagram
    users ||--o{ trips : "crée"
    users ||--o| user_preferences : "configure"
    users ||--o{ trip_collaborators : "participe"
    trips ||--o{ packs : "contient"
    trips ||--o{ trip_collaborators : "partagé via"
    packs ||--o{ trip_votes : "reçoit"

    users {
        uuid id PK
        text email UK
        text password
        text name
        text avatar_url
        timestamptz created_at
    }
    trips {
        uuid id PK
        uuid user_id FK
        text destination
        text origin
        date departure
        date return_date
        int travelers
        text mode
        text status
        float score
        jsonb pack_data
    }
    packs {
        uuid id PK
        uuid trip_id FK
        int rank
        float score
        jsonb pack_data
        boolean selected
    }
    trip_votes {
        uuid id PK
        uuid pack_id FK
        text item_id
        text voter_name
        boolean vote_type
    }
    user_preferences {
        uuid user_id PK
        text default_mode
        text preferred_prefs
        text home_city
        text currency
    }
    trip_collaborators {
        uuid trip_id PK
        uuid user_id PK
        text role
        timestamptz invited_at
    }
